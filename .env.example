# AI API 配置（阿里灵积 MaaS · 默认凭证，用于 DeepSeek / Tongyi / Kimi 等模型）
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://your-region.maas.aliyuncs.com/compatible-mode/v1

# 邮件推送配置（QQ 邮箱）
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-number@qq.com
SMTP_PASSWORD=your-qq-auth-code
EMAIL_RECIPIENT=recipient@example.com
# 设为 true 时仅打印邮件，不实际发送（本地测试用）
EMAIL_DRY_RUN=true
